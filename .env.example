# ==============================================================================
# BACKEND (Coolify Application: Backend / Local Development)
# ==============================================================================

# Telegram Bot Configuration
BOT_TOKEN=123456:CHANGE_ME
BOT_USERNAME=mini_football_robot
ADMIN_TELEGRAM_IDS=123456789,987654321

# Database Configuration
# For Coolify native MongoDB (Internal URL from Coolify resource):
# MONGO_URL=mongodb://root:password@<mongo-container-uuid>:27017/football_bot?authSource=admin&directConnection=true
# For local dev:
MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=football_bot

# Localization
DEFAULT_TIMEZONE=Europe/Kyiv

# WebApp & Authentication
WEBAPP_URL=https://football.your-domain.com
JWT_SECRET=generate-a-strong-random-secret-key-at-least-32-chars!

# Default Payment Details (Optional, can also be configured via Admin Bot menu)
CARD_NUMBER=4441 1111 2222 3333
CARD_RECIPIENT=Иван И.

# ==============================================================================
# FRONTEND (Coolify Application: Frontend - Build-time variable)
# ==============================================================================
# If frontend is deployed on the same domain as backend (or reverse proxied): leave empty.
# If frontend is on a separate domain/subdomain from API: specify backend URL (e.g. https://api.your-domain.com)
VITE_API_BASE_URL=
